[Unit]
Description=In silico PCR web UI
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/Fair
Environment=HOST=0.0.0.0
Environment=PORT=8000
Environment=OPEN_BROWSER=0
Environment=PYTHONUNBUFFERED=1
# Optional: Environment=BLASTN_PATH=/usr/bin/blastn
LimitNOFILE=65535
ExecStart=/root/Fair/deploy/run_gunicorn.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
